# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# Claude Code per-user settings and agent worktrees (shared memory
# notes stay tracked)
.claude/settings.local.json
.claude/worktrees/

# Build artifacts
*.o
*.air
*.metallib

# Generated model files (recreate with scripts/ and repack_experts.py)
model_weights.bin
model_weights.json
# Vision tower (tools/export_vision.py) and encoder reference data
vision_weights.bin
vision_weights.json
*.rgb
*.emb
vocab.bin
tokenizer.bin
packed_experts/
packed_experts_*/
*.safetensors
models/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
*.so
.python-version

# Node (Mermaid tooling for the README diagrams: parser, mermaid-cli)
node_modules/
npm-debug.log*
package-lock.json

# Raw screen recordings and frame dumps (README demos are committed
# only as encoded GIFs / PNG stills in docs/media/)
*.mov
*.mp4
*.webm
frames/

# macOS
.DS_Store

# Third-party reference documents (vendor manuals, others' papers) are
# not ours to redistribute — link to them instead. paper/ is flash-moe's
# own paper and stays tracked.
*.pdf
!paper/*.pdf

# Local secrets and environment (tokens, signing or license keys)
.env
.env.*
*.pem
*.key

# Profiling / experiment artifacts
*.gputrace/
*.trace/
*.npz
logs/
*.log

# Experiment and telemetry data (Phase 0 baselines, streaming counters,
# routing profiles for hot-tier seeding)
routing_data.bin
telemetry/
profiles/
*.csv
# Routing profiles for hot-tier seeding (RsCtx::save_routing_profile)
*.prof
# Routing traces (STREAMMOE_ROUTING_TRACE) and their replays
# (tools/sim_expert_cache.py), NumPy reference outputs
# (tools/olmoe_ref.py), harness results
traces/
traces_*/
routing_trace*.txt
ref_*.json
results/
# KV-format measurement runs (harness outputs, generated needle prompt)
runs/
p_needle.json
# attn_threads measurement runs
kv/attn/

# Rust
target/
Cargo.lock

# Generated per-variant index (rebuild via tools/gen_expert_index.py)
expert_index_*.json
# Expert index written by the README setup steps
expert_index.json

# Requantized expert copies (tools/requant_experts.py → root-3bit/) and
# quality-harness outputs (tools/chat `quality`: --save-ref log-probs,
# per-run result JSON)
root-*bit/
ref_*.bin
q_*.json
